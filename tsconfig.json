{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "storage-service/src/**/*.ts", "contracts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "contracts/artifacts", "contracts/cache"]
}
